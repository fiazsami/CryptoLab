{
  "name": "cryptolab",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Live Binance.US market viewer: browse every pair, stream any one, one command",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --watch-path=server --watch-path=shared server/main.ts",
    "build": "vite build",
    "start": "vite build && NODE_ENV=production node server/main.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "node scripts/smoke.ts",
    "typecheck": "tsc -p tsconfig.json && svelte-check --tsconfig web/tsconfig.json --fail-on-warnings",
    "lint": "eslint .",
    "check": "npm run typecheck && npm run lint"
  },
  "dependencies": {
    "lightweight-charts": "^5.3.0",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^24.0.0",
    "@types/ws": "^8.18.2",
    "eslint": "^10.15.0",
    "eslint-plugin-svelte": "^3.24.1",
    "globals": "^17.14.0",
    "svelte": "^5.59.1",
    "svelte-check": "^4.7.8",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
